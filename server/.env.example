# Port for the API + websocket server
PORT=3000

# Allowed college email domains (exact domains or suffixes). Comma separated.
COLLEGE_DOMAINS=cambridge.edu.in

# Optional: Expo access token to send real push notifications when the app is in background.
# Without it the app still receives live in-app notifications over the websocket.
# EXPO_ACCESS_TOKEN=your_expo_access_token
